<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Super Mario World</string>

    <!-- Tema Wear OS otimizado: sem swipe to dismiss para não sair acidentalmente ao andar para direita -->
    <style name="WearGameTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowSwipeToDismiss">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
